<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>pinot-plugins</artifactId>
    <groupId>org.apache.pinot</groupId>
    <version>1.7.0-SNAPSHOT</version>
  </parent>

  <artifactId>pinot-gpu-execution</artifactId>
  <name>Pinot GPU Query Execution</name>
  <url>https://pinot.apache.org/</url>
  <properties>
    <pinot.root>${basedir}/../..</pinot.root>
    <plugin.type>pinot-gpu-execution</plugin.type>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-core</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!--
      Builds the experimental Metal (Apple GPU) backend's native library and packages it into the jar under
      native/darwin-aarch64/. Opt-in, on macOS / Apple Silicon only (needs the Xcode Command Line Tools):
        ./mvnw -pl pinot-plugins/pinot-gpu-execution package -Dpinot.gpu.metal=true
      Without it, or on any other platform, the Metal backend reports itself unavailable and queries use the regular
      CPU plan. A prebuilt library can also be supplied at runtime with -Dpinot.gpu.metal.library=/path/to.dylib.
      Linux CI does not compile the native code.
    -->
    <profile>
      <id>gpu-metal-native</id>
      <activation>
        <property>
          <name>pinot.gpu.metal</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>build-metal-native-library</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${project.basedir}/src/main/native/build-metal.sh</executable>
                  <arguments>
                    <argument>${project.build.outputDirectory}/native/darwin-aarch64</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
